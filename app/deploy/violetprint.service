# Violet Print — systemd 单元示例（Linux 局域网服务器）
#
#   sudo cp deploy/violetprint.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now violetprint
#   journalctl -u violetprint -f
#
# 注意：务必保持 workers=1（SQLite + 打印队列/对话排队/登录限流都在进程内存里）
[Unit]
Description=Violet Print 校园 3D 打印自助平台
After=network-online.target

[Service]
Type=simple
User=print
WorkingDirectory=/opt/violetprint/app/backend
# 变量名不带 E3DP_ 前缀（见 core/config.py）；监听地址/端口由下面 ExecStart 决定
Environment=JWT_SECRET=请替换为随机长字符串
Environment=ROOT_PASSWORD=请替换为强口令
# LLM_BASE_URL / LLM_API_KEY / DATABASE_URL / CORS_ORIGINS 也在这里配
ExecStart=/opt/violetprint/app/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
