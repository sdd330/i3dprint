# Violet Print — 生产环境配置示例（复制为 backend/.env 后按需修改）
# 注意：变量名不带 E3DP_ 前缀（Settings 未设 env_prefix，带前缀的写法不生效）
# 备注：所有项也可以在「负责人 → 软件设置」里改（DB 覆盖 env，改动即时生效）

# ---- 服务 ----
# 局域网部署必须绑 0.0.0.0，否则只有本机能访问
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# 前端构建产物目录（默认 ../frontend/dist，由后端同源托管）
# FRONTEND_DIST=/opt/violetprint/app/frontend/dist

# ---- 安全（务必修改）----
# 生成一个 32+ 位随机串：openssl rand -hex 32
# JWT_SECRET=请替换为随机长字符串
# JWT_EXPIRE_MINUTES=720
# 同源部署（学生直接访问 http://<服务器IP>:8000）无需 CORS，可留空；
# 若前后端分离（npm run dev 或独立静态站），把来源列出来，逗号分隔：
# CORS_ORIGINS=http://192.168.1.10:5173,http://print.local
# 局域网内教师/学生机器数量多时可临时放宽（仅内网使用）：
# CORS_ORIGINS=*

# ---- AI 对话（任意 OpenAI 兼容端点）----
# 本地 LM Studio：
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen/qwen3-4b
# 生产（在线模型，非思考模式）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-v3.x-flash
# 并发：0=自动（本地/局域网 1，在线 4）
# LLM_MAX_CONCURRENT=0
# LLM_QUEUE_TIMEOUT_SEC=0

# ---- 向量检索（站娘知识库）----
# EMBEDDING_ENABLED=true
# EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# EMBEDDING_MODEL=text-embedding-text2vec-bge-large-chinese-i1

# ---- 上传与解析 ----
# MAX_UPLOAD_BYTES=314572800
# ANALYSIS_TIMEOUT_SEC=90
