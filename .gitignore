# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
*.local

# ---- 环境变量与密钥（不提交） ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- 运行时数据（数据库/上传文件/日志） ----
*.db
*.sqlite3
data/
uploads/
storage/
logs/
*.log

# ---- IDE / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ---- 本地工具输出 ----
/tmp/

.playwright-cli

# ---- 原生扩展编译产物（C 源码入库，产物本机编译）----
app/backend/native/*.dylib
app/backend/native/*.so
app/backend/native/*.o



# 数据库快照目录（刻意入库，见 dbbackup/README.md）
!dbbackup/
!dbbackup/*.db
